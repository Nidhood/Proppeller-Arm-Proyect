<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prop_arm_control">

    <!-- Load physics-only parameters -->
    <xacro:arg name="motor_config" default="$(find prop_arm_gazebo_control)/config/motor_model.yaml"/>

    <!-- Convenience aliases -->
    <xacro:property name="RAW" value="${xacro.load_yaml('$(arg motor_config)')}"/>
    <xacro:property name="P" value="${RAW['prop_arm_gazebo_control']['ros__parameters']}"/>
    <xacro:property name="MM" value="${P['motor_model']}"/>
    <xacro:property name="CTRL" value="${P['control']}"/>
    <xacro:property name="RC" value="${P['ros2_control']}"/>

    <!-- GZ ROS2 control plugin -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find prop_arm_gazebo_control)/config/ros2_controllers_motor_force.yaml</parameters>
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
    </gazebo>

    <ros2_control name="PropArmSystem" type="system">
        <hardware>
            <plugin>prop_arm_gazebo_control/PropArmHardware</plugin>
            <param name="robot_namespace">${RC['robot_namespace']}</param>
            <param name="joint_name">${RC['joint_name']}</param>
            <param name="actuator_index">${RC['actuator_index']}</param>
            <param name="prop_radius_m">${MM['prop_radius_m']}</param>
            <param name="c1">${MM['c1']}</param>
            <param name="c2">${MM['c2']}</param>
            <param name="d1">${MM['d1']}</param>
            <param name="d2">${MM['d2']}</param>
            <param name="L_w">${MM['L_w']}</param>
            <param name="Ts">${MM['Ts']}</param>
            <param name="pwm_min_us">${MM['pwm_min_us']}</param>
            <param name="pwm_max_us">${MM['pwm_max_us']}</param>
            <param name="motor_cmd_scale">${MM['motor_cmd_scale']}</param>
            <param name="pwm_spin_min_us">${MM['pwm_spin_min_us']}</param>
        </hardware>

        <joint name="arm_link_joint">
            <command_interface name="effort">
                <param name="min">${CTRL['command_effort_min']}</param>
                <param name="max">${CTRL['command_effort_max']}</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">${CTRL['initial_position']}</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">${CTRL['initial_velocity']}</param>
            </state_interface>

        </joint>
    </ros2_control>
</robot>
