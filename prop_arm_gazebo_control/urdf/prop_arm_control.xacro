<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prop_arm_control">

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find prop_arm_gazebo_control)/config/ros2_controllers_motor_force.yaml</parameters>
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
    </gazebo>

    <ros2_control name="PropArmSystem" type="system">
        <hardware>
            <plugin>prop_arm_gazebo_control/PropArmHardware</plugin>
            <param name="robot_namespace">arm_sim</param>
            <param name="joint_name">arm_link_joint</param>
            <param name="actuator_index">0</param>
            <param name="prop_radius_m">0.1</param>
            <param name="Kw">1.4016</param>
            <param name="tau_w">0.564</param>
            <param name="L_w">0.294</param>
            <param name="Ts">0.01</param>
            <param name="pwm_ref_us">1000</param>
            <param name="pwm_max_us">2000</param>
            <param name="pwm_min_us">1000</param>
            <param name="motor_cmd_scale">1.162</param>
        </hardware>

        <joint name="arm_link_joint">
            <command_interface name="effort">
                <param name="min">0.0</param>
                <param name="max">750.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">0.16643634279943126</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
    </ros2_control>
</robot>
